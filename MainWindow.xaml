<Window x:Class="CdRipper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CD Ripper" Height="640" Width="920" MinHeight="500" MinWidth="740"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Drive:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="DriveBox" Width="80" Margin="0,0,8,0" />
            <Button Content="Rescan drives" Padding="12,4" Margin="0,0,8,0" Click="Rescan_Click" />
            <Button x:Name="ReadButton" Content="Read disc" Padding="16,4" FontWeight="SemiBold" Click="Read_Click" />
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="DiscIdText" IsReadOnly="True" BorderThickness="0"
                 Background="Transparent" Margin="0,0,0,8" />

        <ListBox Grid.Row="2" x:Name="ReleaseList" MaxHeight="130" Margin="0,0,0,10"
                 DisplayMemberPath="DisplayText" SelectionChanged="ReleaseList_SelectionChanged" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="250" Height="250" VerticalAlignment="Top" HorizontalAlignment="Left"
                    BorderBrush="#FFBBBBBB" BorderThickness="1" Background="#FFF2F2F2">
                <Grid>
                    <Image x:Name="CoverImage" Stretch="Uniform" />
                    <TextBlock x:Name="NoCoverText" Text="No cover" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <DataGrid Grid.Column="1" x:Name="TrackGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="180" />
                    <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
